# Copy to .env and fill in only what the pipelines you install need.
# .env is gitignored. Values must be at least 8 characters.

# stale-prs, issues-already-fixed, weekly-briefing: a GitHub token with
# read access to the repositories (fine-grained, "Contents", "Issues" and
# "Pull requests": read-only).
GITHUB_TOKEN=

# Optional: push notifications to your phone with https://ntfy.sh.
# Pick a long, hard-to-guess topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
